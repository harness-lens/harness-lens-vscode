{
  "name": "harness-lens",
  "displayName": "Harness Lens",
  "version": "0.0.3",
  "publisher": "harness-lens",
  "description": "Discover and analyze coding-agent harness files with the Harness Lens language server.",
  "icon": "media/harness-lens-icon.png",
  "galleryBanner": {
    "color": "#041b33",
    "theme": "dark"
  },
  "preview": true,
  "private": true,
  "license": "MPL-2.0",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agents",
    "harness",
    "instructions"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "harnessLens.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Harness Lens"
      },
      {
        "command": "harnessLens.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Harness Lens"
      },
      {
        "command": "harnessLens.openCenter",
        "title": "Open Metrics Center",
        "category": "Harness Lens",
        "icon": "$(dashboard)"
      },
      {
        "command": "harnessLens.refreshObservability",
        "title": "Refresh Workspace Report",
        "category": "Harness Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "harnessLens.refreshRuntime",
        "title": "Refresh Runtime Evidence",
        "category": "Harness Lens",
        "icon": "$(pulse)"
      },
      {
        "command": "harnessLens.enableCodeBurn",
        "title": "Enable CodeBurn Provider",
        "category": "Harness Lens"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harnessLens",
          "title": "Harness Lens",
          "icon": "media/harness-lens.svg"
        }
      ]
    },
    "views": {
      "harnessLens": [
        {
          "id": "harnessLens.observability",
          "name": "Workspace Observability"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "harnessLens.observability",
        "contents": "Inspect harness cost, quality, provenance, and history.\n[Open Metrics Center](command:harnessLens.openCenter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "harnessLens.openCenter",
          "when": "view == harnessLens.observability",
          "group": "navigation@1"
        },
        {
          "command": "harnessLens.refreshObservability",
          "when": "view == harnessLens.observability",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Harness Lens",
      "properties": {
        "harnessLens.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Start the Harness Lens language server when harness files are present."
        },
        "harnessLens.languageServer.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Optional path to `harness-lens-lsp`. When empty on Windows, Harness Lens discovers `%LOCALAPPDATA%\\HarnessLens\\bin\\harness-lens-lsp.exe` installed by the official Windows installer, then falls back to `PATH`."
        },
        "harnessLens.languageServer.arguments": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "machine",
          "description": "Additional arguments passed to the language server."
        },
        "harnessLens.report.maxFiles": {
          "type": "integer",
          "default": 5000,
          "minimum": 1,
          "maximum": 50000,
          "scope": "resource",
          "description": "Maximum files scanned for one bounded workspace report."
        },
        "harnessLens.runtime.mode": {
          "type": "string",
          "enum": ["off", "live", "snapshot"],
          "default": "off",
          "scope": "window",
          "markdownDescription": "Runtime evidence mode for this VS Code window. `off` performs deterministic analysis only. `live` runs CodeBurn aggregate commands only after the optional provider is enabled. `snapshot` reads a canonical aggregate snapshot without launching CodeBurn."
        },
        "harnessLens.providers.codeburn.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Explicitly enable the optional, separately installed CodeBurn provider for this VS Code window. Enabling does not install CodeBurn or start it while runtime mode is `off`."
        },
        "harnessLens.runtime.executable": {
          "type": "string",
          "default": "codeburn",
          "scope": "machine",
          "description": "CodeBurn executable used only when runtime mode is live."
        },
        "harnessLens.runtime.period": {
          "type": "string",
          "default": "30days",
          "scope": "window",
          "description": "Validated CodeBurn period selector used by this VS Code window in live mode."
        },
        "harnessLens.runtime.snapshotPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Canonical aggregate JSON snapshot path used only in snapshot mode."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "check": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && vsce package --no-dependencies --out ../../artifacts/harness-lens.vsix",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --outdir=.test-build && node --test .test-build/*.test.js",
    "vscode:prepublish": "npm run build --workspace @harness-lens/vscode && npm run build",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap --watch"
  },
  "dependencies": {
    "@harness-lens/vscode": "0.0.3",
    "vscode-languageclient": "^10.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harness-lens/harness-lens-vscode",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/harness-lens/harness-lens-vscode#readme",
  "bugs": {
    "url": "https://github.com/harness-lens/harness-lens-vscode/issues"
  }
}
